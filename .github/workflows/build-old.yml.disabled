name: Build AFTAB PAK TOOL APK

on:
  workflow_dispatch:
  push:
    branches: ["main"]

env:
  PYTHONFORANDROID_PREREQUISITES_INSTALL_INTERACTIVE: "0"

jobs:
  build-android:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout project
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          java-version: "17"
          distribution: "temurin"

      - name: Install system dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            git \
            zip \
            unzip \
            autoconf \
            libtool \
            libltdl-dev \
            pkg-config \
            zlib1g-dev \
            libncurses5-dev \
            libncursesw5-dev \
            cmake \
            libffi-dev \
            libssl-dev \
            automake

      - name: Install Buildozer
        run: |
          python -m pip install --upgrade pip
          python -m pip install buildozer cython==0.29.37

      - name: Prepare stable Android config
        run: |
          python - <<'PY'
          from pathlib import Path
          import re

          p = Path("buildozer.spec")
          s = p.read_text()

          # Remove old local p4a path
          s = re.sub(
              r"(?m)^[ \t]*p4a\.source_dir[ \t]*=.*\n?",
              "",
              s
          )

          # Use stable python-for-android release
          if re.search(r"(?m)^[ \t]*#?[ \t]*p4a\.branch[ \t]*=", s):
              s = re.sub(
                  r"(?m)^[ \t]*#?[ \t]*p4a\.branch[ \t]*=.*$",
                  "p4a.branch = v2026.05.09",
                  s
              )
          else:
              s = s.replace(
                  "[app]\n",
                  "[app]\np4a.branch = v2026.05.09\n",
                  1
              )

          # Pin Python 3.11 for Android + hostpython
          m = re.search(
              r"(?m)^requirements[ \t]*=[^\n]*$",
              s
          )

          if not m:
              raise SystemExit("requirements line not found")

          req = [
              x.strip()
              for x in m.group(0).split("=", 1)[1].split(",")
              if x.strip()
          ]

          req = [
              x for x in req
              if not x.startswith("python3")
              and not x.startswith("hostpython3")
          ]

          req = [
              "python3==3.11.10",
              "hostpython3==3.11.10"
          ] + req

          s = (
              s[:m.start()]
              + "requirements = "
              + ",".join(req)
              + s[m.end():]
          )

          # Accept Android SDK licenses automatically
          if re.search(
              r"(?m)^[ \t]*#?[ \t]*android\.accept_sdk_license[ \t]*=",
              s
          ):
              s = re.sub(
                  r"(?m)^[ \t]*#?[ \t]*android\.accept_sdk_license[ \t]*=.*$",
                  "android.accept_sdk_license = True",
                  s
              )
          else:
              s = s.replace(
                  "[app]\n",
                  "[app]\nandroid.accept_sdk_license = True\n",
                  1
              )

          # Android API 35
          if not re.search(
              r"(?m)^android\.api[ \t]*=",
              s
          ):
              s = s.replace(
                  "[app]\n",
                  "[app]\nandroid.api = 35\n",
                  1
              )

          p.write_text(s)
          PY

          echo "===== buildozer.spec ====="
          cat buildozer.spec

      - name: Pre-fetch Android toolchain
        run: |
          buildozer android p4a -- --help

      - name: Build APK
        run: |
          buildozer -v android debug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: AFTAB-PAK-TOOL-APK
          path: bin/*.apk
          if-no-files-found: error
